{
  // Cloudflare Workers（静的アセット + 小さな Worker）で公開する設定。
  // 公開するのは Blazor WebAssembly の静的サイト（publish/wwwroot。npm run publish:site / publish:site:develop が dotnet publish と本文入りの入口ページの作成を行う）。
  //   本番:   npx wrangler deploy              → https://fara-labs.com/       （Deploy ワークフロー・master への push。手動でも実行可）
  //   確認用: npx wrangler deploy --env develop → https://dev.fara-labs.com/   （Deploy (develop) ワークフロー・develop への push）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fara-labs",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // 報告の 1 日の送信回数の制限（送信元ごと 3 回）。Durable Object（SQLite）。環境は継承しないので、env.develop にも書く
  "durable_objects": {
    "bindings": [{ "name": "REPORT_LIMITER", "class_name": "ReportRateLimiter" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReportRateLimiter"] }
  ],
  // ダッシュボードで足した変数（MAINTENANCE_MODE・MAINTENANCE_MESSAGE など）を、公開（wrangler deploy）のたびに消さない（トップレベルだけが有効）
  "keep_vars": true,
  "assets": {
    "directory": "./publish/wwwroot",
    "binding": "ASSETS",
    // 存在しない URL は、404.html（読み込み表示だけの汎用。kit の build-pages が作る）を 404 で返し、そこで Blazor が起動して、404 の画面を描く
    "not_found_handling": "404-page",
    // すべてのリクエストを Worker（worker/index.js）に通す。メンテナンス中の 503・メンテナンスの状態（/api/maintenance）・報告の受け口のため
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fara-labs.com", "custom_domain": true }
  ],
  "env": {
    "develop": {
      // Worker 名（ダッシュボードで変更した名前に合わせる）
      "name": "fara-labs-dev",
      "durable_objects": {
        "bindings": [{ "name": "REPORT_LIMITER", "class_name": "ReportRateLimiter" }]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ReportRateLimiter"] }
      ],
      "assets": {
        "directory": "./publish/wwwroot",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": true
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "dev.fara-labs.com", "custom_domain": true }
      ]
    }
  }
}
