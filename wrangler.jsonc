{
  // Cloudflare Workers（静的アセット + 小さな Worker）で公開する設定。
  // 公開するのは書き出した静的サイト（dist/。dotnet run --project src/FaraPortfolio.Web -c Release --no-launch-profile -- --export dist）。
  //   本番:   npx wrangler deploy              → https://fara-labs.com/       （Deploy ワークフロー・master への push。手動でも実行可）
  //   確認用: npx wrangler deploy --env develop → https://dev.fara-labs.com/   （Deploy (develop) ワークフロー・develop への push）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fara-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // ダッシュボードで足した変数（MAINTENANCE・MAINTENANCE_MESSAGE など）を、公開（wrangler deploy）のたびに消さない（トップレベルだけが有効）
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 存在しない URL は、書き出した 404 ページ（dist/404.html）を 404 で返す
    "not_found_handling": "404-page",
    // すべてのリクエストを Worker（worker/index.js）に通す。お知らせの帯・メンテナンス中の 503・報告の受け口のため
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fara-labs.com", "custom_domain": true }
  ],
  "env": {
    "develop": {
      // Worker 名（ダッシュボードで変更した名前に合わせる）
      "name": "fara-portfolio-dev",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": true
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "dev.fara-labs.com", "custom_domain": true }
      ]
    }
  }
}
