{
    "name": "Fara Labs",
    "origin": "https://fara-labs.com",
    "devOrigin": "https://dev.fara-labs.com",
    "lang": "ja",
    "locale": "ja_JP",
    "bodyRootClass": "entry-static",
    "developRobots": "allow",
    "csp": {
        "scriptSrc": [
            "https://static.cloudflareinsights.com",
            "https://challenges.cloudflare.com"
        ],
        "styleSrc": [
            "https://fonts.googleapis.com"
        ],
        "fontSrc": [
            "https://fonts.gstatic.com"
        ],
        "imgSrc": [],
        "connectSrc": [
            "https://cloudflareinsights.com",
            "https://challenges.cloudflare.com"
        ],
        "frameSrc": [
            "https://challenges.cloudflare.com"
        ],
        "cacheRules": [
            {
                "path": "/_framework/*.wasm",
                "value": "public, max-age=31536000, immutable"
            },
            {
                "path": "/_framework/dotnet.native.*.js",
                "value": "public, max-age=31536000, immutable"
            },
            {
                "path": "/_framework/dotnet.runtime.*.js",
                "value": "public, max-age=31536000, immutable"
            }
        ]
    }
}
