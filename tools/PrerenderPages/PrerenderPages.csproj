<Project Sdk="Microsoft.NET.Sdk">

  <!-- 静的な本文の書き出し: Razor のページ（src/FaraPortfolio.Web）を、サーバー側の HtmlRenderer で HTML にする。
       出力（pages.json）を、fara-site-kit の build-pages（tools/build-pages.mjs）に渡して、入口ページ（本文入り）を作る -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FaraPortfolio.Prerender</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FaraPortfolio.Web\FaraPortfolio.Web.csproj" />
  </ItemGroup>

</Project>
