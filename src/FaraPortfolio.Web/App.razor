@* 静的 SSR の土台。書き出した各ページ（HTML）は、ここから組み立てる。
   描画の前に js-ready を付けて、フェードインの初期状態（.reveal）を、JS が動くときだけ使う（JS が無ければ本文はそのまま見える） *@
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#120a22" />
    <script>document.documentElement.classList.add('js-ready');</script>
    <!-- Google AdSense のサイト所有権の確認（広告のスクリプトはまだ読み込まない） -->
    <meta name="google-adsense-account" content="ca-pub-1153198089337531" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="/css/app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="/js/site.js" defer></script>
    <script src="/js/report.js" defer></script>
</body>
</html>
