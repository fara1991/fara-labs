@* 作品の概要カード（ホーム用）。クリックで作品ページの該当箇所へ。 *@
<a class="work-card spotlight accent-@Work.Accent reveal" style="--d:@Delay" href="works#@Work.Id">
    <div class="work-card-top">
        <span class="work-icon"><Icon Name="@Work.Icon" Size="28" /></span>
        <span class="chip">@Work.Category</span>
    </div>
    <h3>@Work.Title</h3>
    <p class="work-subtitle">@Work.Subtitle</p>
    <p class="muted">@Work.Summary</p>
    <span class="card-more">詳しく見る <Icon Name="arrow-right" Size="16" /></span>
</a>

@code {
    [Parameter, EditorRequired] public Work Work { get; set; } = default!;
    [Parameter] public int Delay { get; set; }
}
