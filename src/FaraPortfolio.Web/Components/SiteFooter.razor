@* 4 サイト共通の形のフッター: サイト名 | 問い合わせ | プライバシーポリシー | © 公開年 Fara（Fara は作者のホームページへ）。
   © の横に SNS のアイコン（プロフィールの SNS のうち、URL が入っているもの）。
   「問い合わせ」には、いま見ているページを ?from= で付ける（報告に、どのページかが分かるように） *@
@inject SiteData Data
@inject SiteOptions Site
@inject NavigationManager Nav

<footer class="site-footer">
    <div class="container site-footer-inner">
        <div class="site-footer-line">
            <span class="site-footer-name">@SiteInfo.Name</span>
            <span class="site-footer-sep" aria-hidden="true">|</span>
            <a href="@ReportHref">問い合わせ</a>
            <span class="site-footer-sep" aria-hidden="true">|</span>
            <a href="/privacy">プライバシーポリシー</a>
            <span class="site-footer-sep" aria-hidden="true">|</span>
            <span class="site-footer-copy">© @SiteInfo.PublishedYear <a href="@Site.Localize(SiteInfo.PortfolioUrl)">@SiteInfo.Author</a></span>
            <span class="footer-socials">
                @foreach (var s in Data.Profile.VisibleSocials)
                {
                    <a class="service-@s.Service" href="@Site.Localize(s.Url)" target="_blank" rel="noopener noreferrer" aria-label="@s.Label" title="@s.Label">
                        <Icon Name="@Icon.ForService(s.Service)" Size="16" />
                    </a>
                }
            </span>
        </div>
    </div>
</footer>

@code {
    private string ReportHref => SiteFooterLinks.ReportHref(new Uri(Nav.Uri).AbsolutePath);
}
