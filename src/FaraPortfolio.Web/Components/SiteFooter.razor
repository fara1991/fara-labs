@inject SiteData Data

<footer class="site-footer">
    <div class="container footer-inner">
        <div class="footer-brand">
            <span class="brand-mark small">f</span>
            <span>© @DateTime.Now.Year @Data.Profile.Name</span>
        </div>
        <div class="footer-socials">
            @foreach (var s in Data.Profile.VisibleSocials)
            {
                <a href="@s.Url" target="_blank" rel="noopener noreferrer" aria-label="@s.Label" title="@s.Label">
                    <Icon Name="@Icon.ForService(s.Service)" Size="18" />
                </a>
            }
        </div>
        <p class="footer-note">Built with C# &amp; Blazor WebAssembly · build @SiteData.BuildId</p>
    </div>
</footer>
