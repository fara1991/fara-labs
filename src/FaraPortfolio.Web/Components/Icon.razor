        ["wave"] = """<path d="M2 12h3l3-8 4 16 4-12 2 4h4"/>""",
    };

    public static bool Exists(string name) => Brands.ContainsKey(name) || Lines.ContainsKey(name);

    private bool IsBrand => Brands.ContainsKey(Name);

    private string Path =>
        Brands.TryGetValue(Name, out var brand) ? brand :
        Lines.TryGetValue(Name, out var line) ? line :
        Lines["link"];

    /// <summary>SNS のサービス名からアイコン名へ（未知のサービスはリンクアイコン）。</summary>
    public static string ForService(string service) => service.ToLowerInvariant() switch
    {
        "github" or "x" or "twitter" or "twitch" or "youtube" or "discord" => service.ToLowerInvariant(),
        "bluesky" => "at",
        "mail" or "email" => "mail",
        _ => "link",
    };
}
