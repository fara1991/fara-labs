@implements IDisposable
@inject NavigationManager Nav

<header class="site-header">
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="container header-inner">
        @* スマホのメニューの開閉（aria-expanded と、CSS の .is-open）。外側のタップ・Esc で閉じるのは js/site.js（このボタンを押す）。ページを移ったら閉じる *@
        <button class="menu-toggle" type="button" aria-label="メニュー" aria-expanded="@(open ? "true" : "false")" aria-controls="site-nav" @onclick="Toggle">
            <span class="menu-icon-open"><Icon Name="menu" Size="22" /></span>
            <span class="menu-icon-close"><Icon Name="close" Size="22" /></span>
        </button>

        <nav id="site-nav" class="site-nav @(open ? "is-open" : "")" aria-label="メイン">
            <a class="nav-link @Active("/")" href="/" aria-current="@Current("/")">Home</a>
            <a class="nav-link @Active("/profile")" href="/profile" aria-current="@Current("/profile")">Profile</a>
            <a class="nav-link @Active("/works")" href="/works" aria-current="@Current("/works")">Works</a>
            <a class="nav-link @Active("/updates")" href="/updates" aria-current="@Current("/updates")">Updates</a>
            <a class="nav-link @Active("/links")" href="/links" aria-current="@Current("/links")">Links</a>
            <a class="nav-link @Active("/report")" href="/report" aria-current="@Current("/report")">Report</a>
            <a class="nav-link @Active("/privacy")" href="/privacy" aria-current="@Current("/privacy")">Policy</a>
        </nav>
    </div>
</header>

@code {
    private bool open;

    /// <summary>いま表示しているページのパス（末尾の / は外す。トップは空）。</summary>
    private string Path => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

    private bool IsCurrent(string href) => Path == href.TrimEnd('/');

    private string Active(string href) => IsCurrent(href) ? "active" : "";

    private string? Current(string href) => IsCurrent(href) ? "page" : null;

    private void Toggle() => open = !open;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        open = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
