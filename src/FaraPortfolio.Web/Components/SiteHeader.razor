@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<header class="site-header">
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="container header-inner">
        @* 左上のサイト名（ホームへ）。リンクの名前は見えている文字「Fara Labs」そのまま *@
        <a class="brand" href="/">Fara Labs</a>

        @* スマホのメニューの開閉（aria-expanded と、CSS の .is-open）。外側のタップ・Esc で閉じるのは js/site.js（このボタンを押す）。ページを移ったら閉じる *@
        <button class="menu-toggle" type="button" aria-label="メニュー" aria-expanded="@(open ? "true" : "false")" aria-controls="site-nav" @onclick="Toggle">
            <span class="menu-icon-open"><Icon Name="menu" Size="22" /></span>
            <span class="menu-icon-close"><Icon Name="close" Size="22" /></span>
        </button>

        <nav id="site-nav" class="site-nav @(open ? "is-open" : "")" aria-label="メイン">
            <a class="nav-link @Active("/")" href="/" aria-current="@Current("/")">ホーム</a>
            <a class="nav-link @Active("/profile")" href="/profile" aria-current="@Current("/profile")">プロフィール</a>
            <a class="nav-link @Active("/works")" href="/works" aria-current="@Current("/works")">作ったもの</a>
            <a class="nav-link @Active("/updates")" href="/updates" aria-current="@Current("/updates")">更新履歴</a>
            <a class="nav-link @Active("/links")" href="/links" aria-current="@Current("/links")">リンク</a>
            <a class="nav-link @Active("/report")" href="/report" aria-current="@Current("/report")">問い合わせ</a>
            <a class="nav-link @Active("/privacy")" href="/privacy" aria-current="@Current("/privacy")">プライバシーポリシー</a>
        </nav>
    </div>
</header>

@code {
    private bool open;
    private bool focusMenu;

    /// <summary>いま表示しているページのパス（末尾の / は外す。トップは空）。</summary>
    private string Path => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

    private bool IsCurrent(string href) => Path == href.TrimEnd('/');

    private string Active(string href) => IsCurrent(href) ? "active" : "";

    private string? Current(string href) => IsCurrent(href) ? "page" : null;

    private void Toggle()
    {
        open = !open;
        focusMenu = open;
    }

    // 開いたとき、最初のリンクへフォーカスを移す（キーボード・読み上げの利用者向け）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusMenu) return;
        focusMenu = false;
        try { await JS.InvokeVoidAsync("faraSite.focusMenu"); }
        catch (JSException) { } // 意図的に握る: フォーカスを移せないだけ（メニューは開いたまま使える）。JS 以外の例外は握らない
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        open = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
