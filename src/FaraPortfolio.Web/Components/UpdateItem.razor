@* 更新履歴の 1 件。NEW は、ブラウザの今日の日付で決める（BrowserClock。静的な本文の書き出しでは付けない） *@
@inject BrowserClock Clock
<li class="update-item">
    <div class="update-date">
        <time datetime="@Entry.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="nowrap">@Entry.Date.ToString("yyyy.MM.dd", CultureInfo.InvariantCulture)</time>
        <span class="update-dow">@DayOfWeekJa(Entry.Date)</span>
    </div>
    <div class="update-body">
        <div class="update-meta">
            <span class="chip cat-@Entry.Category">@UpdateCategories.Label(Entry.Category)</span>
            @if (Clock.IsNew(Entry.Date))
            {
                <span class="chip chip-new">NEW</span>
            }
        </div>
        <h3>@Entry.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Entry.Body))
        {
            <p class="muted">@Entry.Body</p>
        }
        @if (!string.IsNullOrWhiteSpace(Entry.Link))
        {
            var external = Entry.Link.StartsWith("http", StringComparison.OrdinalIgnoreCase);
            <a class="text-link" href="@SiteLinks.Localize(Entry.Link)" target="@(external ? "_blank" : null)" rel="@(external ? "noopener noreferrer" : null)">
                @(Entry.LinkLabel ?? "詳しく見る") <Icon Name="@(external ? "external" : "arrow-right")" Size="15" />
            </a>
        }
    </div>
</li>

@code {
    [Parameter, EditorRequired] public UpdateEntry Entry { get; set; } = default!;
    [Inject] private SiteOptions Site { get; set; } = default!;

    // ブラウザの言語に依存しないよう曜日は自前で持つ
    private static string DayOfWeekJa(DateOnly date) => "日月火水木金土"[(int)date.DayOfWeek].ToString();
}
