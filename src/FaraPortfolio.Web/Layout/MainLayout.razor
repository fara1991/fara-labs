@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MaintenanceInfo Maintenance

@* サイトは、紫のダーク配色だけ（ライト／ダークの切り替えは無い）。MudBlazor（報告フォームの部品）も、ダークで固定する。
   .mud-layout は、kit の読み込み表示（boot-indicator.js）が「描画が終わった」の合図に使う *@
<MudThemeProvider Theme="Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-layout">
    <AppShell>
        <Banner><MaintenanceBanner Info="Maintenance" /></Banner>
        <ChildContent>@Body</ChildContent>
    </AppShell>
</MudLayout>

@code {
    private static readonly MudTheme Theme = SiteTheme.Create();

    // ページを移ったあと（と最初の描画のあと）は、新しい本文に対して js/site.js の pageChanged を呼ぶ（フェードイン・#付きの位置・戻る／進むの位置）
    private bool pageChanged = true;
    private bool back;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        pageChanged = true;
        // 戻る・進む（リンクのクリックではない移動）では、離れたときのスクロール位置へ戻す
        back = !e.IsNavigationIntercepted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pageChanged) return;
        var wasBack = back;
        pageChanged = false;
        back = false;
        try { await JS.InvokeVoidAsync("faraSite.pageChanged", wasBack); }
        catch (JSException) { /* 演出が動かなくても、本文は読める */ }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
