@page "/links"
@inject SiteData Data

<PageTitle>Links | @Data.Profile.Name</PageTitle>

<section class="page container narrow">
    <header class="page-head">
        <h1>SNS・リンク</h1>
        <p class="muted">お気軽にフォローしてください。</p>
    </header>

    <div class="link-list">
        @foreach (var s in Data.Profile.VisibleSocials)
        {
            <a class="link-card glass service-@s.Service" href="@s.Url" target="_blank" rel="noopener noreferrer">
                <span class="link-icon"><Icon Name="@Icon.ForService(s.Service)" Size="26" /></span>
                <span class="link-text">
                    <span class="link-label">@s.Label</span>
                    @if (!string.IsNullOrWhiteSpace(s.Handle))
                    {
                        <span class="link-handle">@s.Handle</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.Description))
                    {
                        <span class="link-desc">@s.Description</span>
                    }
                </span>
                <span class="link-arrow"><Icon Name="external" Size="18" /></span>
            </a>
        }
    </div>
</section>
