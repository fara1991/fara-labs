@page "/updates"
@inject SiteData Data

<PageMeta Title="@($"Updates | {Data.Profile.Name}")" Description="サイトや作品の更新履歴です。" Path="/updates" />

<section class="page container narrow">
    <header class="page-head">
        <h1>更新履歴</h1>
        <p class="muted">サイトや作品の更新情報です。</p>
    </header>

    @* 絞り込みは js/site.js が付ける（JS が無いときは、すべての更新を並べたままにする） *@
    @if (Categories.Count >= 2)
    {
        <div class="filter-bar" role="group" aria-label="カテゴリで絞り込み" data-filter-bar hidden>
            <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">
                すべて <span class="count">@Data.Updates.Count</span>
            </button>
            @foreach (var (key, label, count) in Categories)
            {
                <button type="button" class="filter-chip" data-filter="@key" aria-pressed="false">
                    @label <span class="count">@count</span>
                </button>
            }
        </div>
    }

    @foreach (var year in Data.Updates.GroupBy(u => u.Date.Year))
    {
        <div class="year-group" data-year-group>
            <h2 class="year-heading">@year.Key</h2>
            <ol class="update-list">
                @foreach (var entry in year)
                {
                    <UpdateItem Entry="entry" />
                }
            </ol>
        </div>
    }

    <p class="muted" data-filter-empty hidden>該当する更新はありません。</p>
</section>

@code {
    /// <summary>更新が 1 件以上あるカテゴリ（絞り込みは 2 種類以上あるときだけ出す）。</summary>
    private List<(string Key, string Label, int Count)> Categories =>
        UpdateCategories.All
            .Select(c => (c.Key, c.Label, Count: Data.Updates.Count(u => u.Category == c.Key)))
            .Where(c => c.Count > 0)
            .ToList();
}
