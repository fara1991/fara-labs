@page "/updates"
@inject SiteData Data

<PageTitle>@PageCatalog.Updates(Data.Profile).Title</PageTitle>

<section class="page container narrow">
    <header class="page-head">
        <h1>更新履歴</h1>
        <p class="muted">サイトや作品の更新情報です。</p>
    </header>

    @* 絞り込み（カテゴリが 2 種類以上あるときだけ）。静的な本文の書き出し（JS も Blazor も無い）では、押せないので出さない *@
    @if (Interactive && Categories.Count >= 2)
    {
        <div class="filter-bar" role="group" aria-label="カテゴリで絞り込み">
            <button type="button" class="filter-chip @(selected == "all" ? "is-active" : "")" aria-pressed="@(selected == "all" ? "true" : "false")" @onclick='() => selected = "all"'>
                すべて <span class="count">@Data.Updates.Count</span>
            </button>
            @foreach (var (key, label, count) in Categories)
            {
                <button type="button" class="filter-chip @(selected == key ? "is-active" : "")" aria-pressed="@(selected == key ? "true" : "false")" @onclick="() => selected = key">
                    @label <span class="count">@count</span>
                </button>
            }
        </div>
    }

    @foreach (var year in Shown.GroupBy(u => u.Date.Year))
    {
        <div class="year-group">
            <h2 class="year-heading">@year.Key</h2>
            <ol class="update-list">
                @foreach (var entry in year)
                {
                    <UpdateItem Entry="entry" />
                }
            </ol>
        </div>
    }

    @if (Shown.Count == 0)
    {
        <p class="muted">該当する更新はありません。</p>
    }
</section>

@code {
    /// <summary>ブラウザで動いているか（静的な本文の書き出しでは false。絞り込みのボタンを出さない）。</summary>
    private static bool Interactive => OperatingSystem.IsBrowser();

    private string selected = "all";

    private List<UpdateEntry> Shown => Data.Updates.Where(u => selected == "all" || u.Category == selected).ToList();

    /// <summary>更新が 1 件以上あるカテゴリ（絞り込みは 2 種類以上あるときだけ出す）。</summary>
    private List<(string Key, string Label, int Count)> Categories =>
        UpdateCategories.All
            .Select(c => (c.Key, c.Label, Count: Data.Updates.Count(u => u.Category == c.Key)))
            .Where(c => c.Count > 0)
            .ToList();
}
