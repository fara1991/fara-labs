@page "/not-found"

<PageTitle>ページが見つかりません | Fara</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<section class="page container not-found">
    <p class="not-found-code gradient-text">404</p>
    <h1>ページが見つかりません</h1>
    <p class="muted">URL が間違っているか、ページが移動した可能性があります。</p>
    <a class="btn btn-primary" href="/">ホームへ戻る <Icon Name="arrow-right" Size="18" /></a>
</section>
