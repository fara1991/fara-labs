@page "/profile"
@inject SiteData Data

<PageTitle>@PageCatalog.ProfilePage(Data.Profile).Title</PageTitle>

<section class="page container narrow">
    <header class="page-head">
        <h1 class="name-with-avatar"><img class="avatar" src="/images/avatar.jpg" alt="" />@Data.Profile.Name</h1>
    </header>

    <div class="profile-card glass">
        <p class="profile-bio">@Data.Profile.Bio</p>
    </div>

    @if (Data.Profile.VisibleSocials.Any())
    {
        <h2 class="mini-heading">リンク</h2>
        <div class="link-list">
            @foreach (var s in Data.Profile.VisibleSocials)
            {
                <a class="link-card glass service-@s.Service" href="@SiteLinks.Localize(s.Url)" target="_blank" rel="noopener noreferrer">
                    <span class="link-icon"><Icon Name="@Icon.ForService(s.Service)" Size="26" /></span>
                    <span class="link-text">
                        <span class="link-label">@s.Label</span>
                        @if (!string.IsNullOrWhiteSpace(s.Handle))
                        {
                            <span class="link-handle">@s.Handle</span>
                        }
                    </span>
                    <span class="link-arrow"><Icon Name="external" Size="18" /></span>
                </a>
            }
        </div>
    }
</section>
