@page "/profile"
@inject SiteData Data
@inject SiteOptions Site

<PageMeta Title="@($"Profile | {Data.Profile.Name}")" Description="@Data.Profile.Bio" Path="/profile" />

<section class="page container narrow">
    <header class="page-head">
        <h1 class="name-with-avatar"><img class="avatar" src="/images/avatar.jpg" alt="" />@Data.Profile.Name</h1>
    </header>

    <div class="profile-card glass">
        <p class="profile-bio">@Data.Profile.Bio</p>

        @if (Data.Profile.VisibleSocials.Any())
        {
            <h2 class="mini-heading">Links</h2>
            <div class="cta-socials">
                @foreach (var s in Data.Profile.VisibleSocials)
                {
                    <a class="social-pill service-@s.Service" href="@Site.Localize(s.Url)" target="_blank" rel="noopener noreferrer">
                        <span class="pill-icon"><Icon Name="@Icon.ForService(s.Service)" Size="16" /></span> @s.Label
                    </a>
                }
            </div>
        }
    </div>
</section>
