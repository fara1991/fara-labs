@page "/profile"
@inject SiteData Data

<PageTitle>Profile | @Data.Profile.Name</PageTitle>

<section class="page container narrow">
    <header class="page-head">
        <p class="section-kicker reveal">Profile</p>
        <h1 class="name-with-avatar reveal" style="--d:1"><img class="avatar" src="images/avatar.jpg" alt="" />@Data.Profile.Name</h1>
    </header>

    <div class="profile-card glass reveal" style="--d:2">
        <p class="profile-bio">@Data.Profile.Bio</p>

        @if (Data.Profile.VisibleSocials.Any())
        {
            <h2 class="mini-heading">Links</h2>
            <div class="cta-socials">
                @foreach (var s in Data.Profile.VisibleSocials)
                {
                    <a class="social-pill service-@s.Service" href="@s.Url" target="_blank" rel="noopener noreferrer">
                        <span class="pill-icon"><Icon Name="@Icon.ForService(s.Service)" Size="16" /></span> @s.Label
                    </a>
                }
            </div>
        }
    </div>
</section>
