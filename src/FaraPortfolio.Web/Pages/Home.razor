@page "/"
@inject SiteData Data

<PageTitle>@Data.Profile.Name | Portfolio</PageTitle>

<section class="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <p class="eyebrow reveal"><span class="pulse-dot"></span>Welcome to app-fara.com</p>
            <h1 class="hero-title reveal" style="--d:1">
                <span>Hi, I'm</span>
                <span class="gradient-text">@Data.Profile.Name</span>
            </h1>
            <p class="hero-lead reveal" style="--d:2">@Data.Profile.Tagline</p>
            <div class="hero-actions reveal" style="--d:3">
                <a class="btn btn-primary" href="works">作品を見る <Icon Name="arrow-right" Size="18" /></a>
                <a class="btn btn-ghost" href="links">SNS / リンク</a>
            </div>
        </div>

        <div class="hero-visual reveal" style="--d:2" aria-hidden="true">
            <div class="orbit orbit-outer">
                <span class="satellite s1"><Icon Name="pokeball" Size="22" /></span>
                <span class="satellite s2"><Icon Name="saber" Size="22" /></span>
            </div>
            <div class="orbit orbit-inner">
                <span class="satellite s3"><Icon Name="code" Size="20" /></span>
            </div>
            <div class="core"><span>f</span></div>
        </div>
    </div>
    <a class="scroll-cue" href="#about" aria-label="下へスクロール"><span></span></a>
</section>

<div class="marquee" aria-hidden="true">
    <div class="marquee-track">
        @for (var i = 0; i < 2; i++)
        {
            @foreach (var skill in Data.Profile.Skills)
            {
                <span>@skill</span>
                <span class="marquee-dot">✦</span>
            }
        }
    </div>
</div>

<section id="about" class="section container">
    <div class="about-card glass reveal">
        <p class="section-kicker">About</p>
        <h2>@Data.Profile.Name について</h2>
        <p class="about-bio">@Data.Profile.Bio</p>
        <div class="chip-row">
            @foreach (var skill in Data.Profile.Skills)
            {
                <span class="chip">@skill</span>
            }
        </div>
    </div>
</section>

<section class="section container">
    <div class="section-head reveal">
        <div>
            <p class="section-kicker">Works</p>
            <h2>公開中の作品</h2>
        </div>
        <a class="text-link" href="works">すべて見る <Icon Name="arrow-right" Size="16" /></a>
    </div>
    <div class="work-grid">
        @for (var i = 0; i < Data.Works.Count; i++)
        {
            <WorkCard @key="Data.Works[i].Id" Work="Data.Works[i]" Delay="i" />
        }
    </div>
</section>

<section class="section container">
    <div class="section-head reveal">
        <div>
            <p class="section-kicker">Updates</p>
            <h2>最近の更新</h2>
        </div>
        <a class="text-link" href="updates">更新履歴へ <Icon Name="arrow-right" Size="16" /></a>
    </div>
    @if (Data.Updates.Count == 0)
    {
        <p class="muted">まだ更新はありません。</p>
    }
    else
    {
        <ol class="update-list compact">
            @foreach (var entry in Data.Updates.Take(3))
            {
                <UpdateItem @key="entry" Entry="entry" />
            }
        </ol>
    }
</section>

<section class="section container">
    <div class="cta glass reveal">
        <p class="section-kicker">Links</p>
        <h2>SNS でも発信しています</h2>
        <div class="cta-socials">
            @foreach (var s in Data.Profile.VisibleSocials)
            {
                <a class="social-pill" href="@s.Url" target="_blank" rel="noopener noreferrer">
                    <Icon Name="@Icon.ForService(s.Service)" Size="18" /> @s.Label
                </a>
            }
        </div>
        <a class="btn btn-ghost" href="links">リンク一覧 <Icon Name="arrow-right" Size="18" /></a>
    </div>
</section>
