@page "/"
@inject SiteData Data
@inject SiteOptions Site

<PageMeta Title="@($"{Data.Profile.Name} | Portfolio")" Description="@Data.Profile.Tagline" Path="/" />

<section class="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <h1 class="hero-title reveal" style="--d:1">
                <span>@(Data.Profile.Name)'s</span>
                <span class="gradient-text">Portfolio</span>
            </h1>
            <p class="hero-tagline reveal" style="--d:2">@Data.Profile.Tagline</p>
            <div class="hero-actions reveal" style="--d:3">
                <a class="btn btn-primary" href="/works">作ったものを見る <Icon Name="arrow-right" Size="18" /></a>
                <a class="btn btn-ghost" href="/profile">Profile</a>
            </div>
        </div>

        <div class="hero-visual reveal" style="--d:2">
            @* 作品ごとのアイコンを外側の軌道に等間隔で並べる（クリックで作品へ） *@
            <div class="orbit orbit-outer">
                @for (var i = 0; i < Data.Works.Count; i++)
                {
                    var work = Data.Works[i];
                    var angle = 2 * Math.PI * i / Data.Works.Count;
                    var top = (50 - 50 * Math.Cos(angle)).ToString("0.##", CultureInfo.InvariantCulture);
                    var left = (50 + 50 * Math.Sin(angle)).ToString("0.##", CultureInfo.InvariantCulture);
                    <a class="satellite accent-@work.Accent" style="top:@(top)%;left:@(left)%"
                       href="/works#@work.Id" aria-label="@work.Title">
                        <Icon Name="@work.Icon" Size="22" />
                        @* カーソルを合わせると名前と短い説明を出す（軌道は止まり、アイコンは常に正立しているので上に出す）。左右のはみ出しは js/site.js が合わせる *@
                        <span class="satellite-tip" role="tooltip">
                            <strong>@work.Title</strong>
                            <span>@work.Summary</span>
                        </span>
                    </a>
                }
            </div>
            <div class="orbit orbit-inner" aria-hidden="true"></div>
            <div class="core" aria-hidden="true"><span>F</span></div>
        </div>
    </div>
</section>

<section id="works" class="section container reveal">
    <div class="section-head">
        <div>
            <h2>作ったもの</h2>
        </div>
        <a class="text-link" href="/works">すべて見る <Icon Name="arrow-right" Size="16" /></a>
    </div>
    <div class="work-grid">
        @foreach (var work in Data.Works)
        {
            <WorkCard Work="work" />
        }
    </div>
</section>

<section class="section container reveal">
    <div class="section-head">
        <div>
            <h2>最近の更新</h2>
        </div>
        <a class="text-link" href="/updates">更新履歴へ <Icon Name="arrow-right" Size="16" /></a>
    </div>
    @if (Data.Updates.Count == 0)
    {
        <p class="muted">まだ更新はありません。</p>
    }
    else
    {
        <ol class="update-list compact">
            @foreach (var entry in Data.Updates.Take(3))
            {
                <UpdateItem Entry="entry" />
            }
        </ol>
    }
</section>

<section class="section container reveal">
    <div class="cta glass">
        <div class="cta-socials">
            @foreach (var s in Data.Profile.VisibleSocials)
            {
                <a class="social-pill service-@s.Service" href="@Site.Localize(s.Url)" target="_blank" rel="noopener noreferrer">
                    <span class="pill-icon"><Icon Name="@Icon.ForService(s.Service)" Size="16" /></span> @s.Label
                </a>
            }
        </div>
        <a class="btn btn-ghost" href="/links">リンク一覧 <Icon Name="arrow-right" Size="18" /></a>
    </div>
</section>
